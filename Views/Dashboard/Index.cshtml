@{
    ViewBag.Title = "Dashboard";
}

<div class="page-header">
    <h1>Facility Maintenance Dashboard</h1>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h4 class="panel-title">Total Requests</h4>
            </div>
            <div class="panel-body" style="text-align: center; padding: 30px;">
                <h2 style="color: #3498db; margin: 0;">@ViewBag.TotalRequests</h2>
                <p style="color: #7f8c8d; margin-top: 10px;">All time</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="panel panel-success">
            <div class="panel-heading">
                <h4 class="panel-title">Completed</h4>
            </div>
            <div class="panel-body" style="text-align: center; padding: 30px;">
                <h2 style="color: #27ae60; margin: 0;">@ViewBag.TotalCompleted</h2>
                <p style="color: #7f8c8d; margin-top: 10px;">This period</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="panel panel-warning">
            <div class="panel-heading">
                <h4 class="panel-title">Open</h4>
            </div>
            <div class="panel-body" style="text-align: center; padding: 30px;">
                <h2 style="color: #f39c12; margin: 0;">@ViewBag.TotalOpen</h2>
                <p style="color: #7f8c8d; margin-top: 10px;">Awaiting action</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="panel panel-info">
            <div class="panel-heading">
                <h4 class="panel-title">Avg Resolution</h4>
            </div>
            <div class="panel-body" style="text-align: center; padding: 30px;">
                <h2 style="color: #3498db; margin: 0;">@ViewBag.AverageResolutionTime</h2>
                <p style="color: #7f8c8d; margin-top: 10px;">hours</p>
            </div>
        </div>
    </div>
</div>

<div class="row" style="margin-top: 20px;">
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">Quick Actions</h4>
            </div>
            <div class="panel-body">
                <a href="@Url.Action("Create", "MaintenanceRequest")" class="btn btn-primary btn-block" style="margin-bottom: 10px;">
                    <span class="glyphicon glyphicon-plus"></span> Submit New Request
                </a>
                <a href="@Url.Action("MyRequests", "MaintenanceRequest")" class="btn btn-default btn-block" style="margin-bottom: 10px;">
                    <span class="glyphicon glyphicon-list"></span> View My Requests
                </a>
                <a href="@Url.Action("PendingApprovals", "Approval")" class="btn btn-warning btn-block" style="margin-bottom: 10px;">
                    <span class="glyphicon glyphicon-check"></span> Pending Approvals
                </a>
                <a href="@Url.Action("Dashboard", "Reporting")" class="btn btn-info btn-block">
                    <span class="glyphicon glyphicon-stats"></span> View Reports
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">Recommendations</h4>
            </div>
            <div class="panel-body">
                @if (ViewBag.Recommendations != null && ((List<string>)ViewBag.Recommendations).Count > 0)
                {
                    <ul style="padding-left: 20px;">
                        @foreach (var rec in (List<string>)ViewBag.Recommendations)
                        {
                            <li style="margin-bottom: 10px;">@rec</li>
                        }
                    </ul>
                }
                else
                {
                    <p>No recommendations at this time.</p>
                }
            </div>
        </div>
    </div>
</div>
