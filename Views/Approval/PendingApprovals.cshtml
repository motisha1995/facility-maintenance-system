@{
    ViewBag.Title = "Pending Approvals";
}

<div class="page-header">
    <h2>Requests Awaiting Approval</h2>
</div>

@if (ViewBag.Requests != null && ((IEnumerable<dynamic>)ViewBag.Requests).Count() > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Tracking ID</th>
                    <th>Title</th>
                    <th>Urgency</th>
                    <th>Requested By</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in (IEnumerable<dynamic>)ViewBag.Requests)
                {
                    <tr>
                        <td><strong>@request.TrackingId</strong></td>
                        <td>@request.Title</td>
                        <td><span class="urgency-badge urgency-@request.Urgency.ToString().ToLower()">@request.Urgency</span></td>
                        <td>@request.Employee.FirstName @request.Employee.LastName</td>
                        <td>@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @using (Html.BeginForm("Review", "Approval", new { id = request.RequestId }, FormMethod.Get))
                            {
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <span class="glyphicon glyphicon-eye-open"></span> Review
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <strong>No pending approvals.</strong> All requests have been reviewed.
    </div>
}
