@model FacilityMaintenanceSystem.Models.RequestFeedback
@{
    ViewBag.Title = "Feedback Survey";
}

<div class="page-header">
    <h2>Service Feedback Survey</h2>
    <p class="text-muted">Thank you for using our maintenance service. Please rate your experience.</p>
</div>

@using (Html.BeginForm("Survey", "Feedback", new { id = Model.RequestId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">Rate Your Experience</h4>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <label><strong>Overall Satisfaction (Required)</strong></label>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <label style="margin-right: 15px; font-weight: normal;">
                                    <input type="radio" name="SatisfactionRating" value="@i" required="required" />
                                    @switch (i)
                                    {
                                        case 1:
                                            <span>Poor</span>
                                            break;
                                        case 2:
                                            <span>Fair</span>
                                            break;
                                        case 3:
                                            <span>Good</span>
                                            break;
                                        case 4:
                                            <span>Very Good</span>
                                            break;
                                        case 5:
                                            <span>Excellent</span>
                                            break;
                                    }
                                </label>
                            }
                        </div>
                    </div>

                    <hr />

                    <div class="form-group">
                        <label><strong>Work Quality</strong></label>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <label style="margin-right: 15px; font-weight: normal;">
                                    <input type="radio" name="WorkQuality" value="@i" />
                                    @i ★
                                </label>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label><strong>Timeliness</strong></label>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <label style="margin-right: 15px; font-weight: normal;">
                                    <input type="radio" name="Timeliness" value="@i" />
                                    @i ★
                                </label>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label><strong>Professionalism</strong></label>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <label style="margin-right: 15px; font-weight: normal;">
                                    <input type="radio" name="Professionalism" value="@i" />
                                    @i ★
                                </label>
                            }
                        </div>
                    </div>

                    <hr />

                    <div class="form-group">
                        <label><strong>Additional Comments</strong></label>
                        @Html.TextAreaFor(m => m.Comments, new { @class = "form-control", rows = 4, placeholder = "Share any additional feedback or suggestions" })
                    </div>

                    <button type="submit" class="btn btn-success btn-lg">
                        <span class="glyphicon glyphicon-ok"></span> Submit Feedback
                    </button>
                    <a href="@Url.Action("MyRequests", "MaintenanceRequest")" class="btn btn-default btn-lg" style="margin-left: 10px;">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
}
