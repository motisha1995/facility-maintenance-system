@model IEnumerable<FacilityMaintenanceSystem.Models.MaintenanceRequest>
@{
    ViewBag.Title = "Maintenance Requests";
}

<div class="page-header">
    <h2>All Maintenance Requests</h2>
</div>

<div class="row" style="margin-bottom: 20px;">
    <div class="col-md-12">
        @Html.ActionLink("Submit New Request", "Create", null, new { @class = "btn btn-primary" })
        @Html.ActionLink("Filter", "Filter", null, new { @class = "btn btn-default" })
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Tracking ID</th>
                <th>Title</th>
                <th>Location</th>
                <th>Urgency</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count() > 0)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@Html.DisplayFor(modelItem => item.TrackingId)</strong></td>
                        <td>@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>@Html.DisplayFor(modelItem => item.Location.FullLocation)</td>
                        <td>
                            <span class="urgency-badge urgency-@item.Urgency.ToLower()">
                                @item.Urgency
                            </span>
                        </td>
                        <td>
                            <span class="status-badge status-@item.Status.ToLower().Replace(" ", "")">
                                @item.Status
                            </span>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                        <td>
                            @Html.ActionLink("View", "Details", new { id = item.RequestId }, new { @class = "btn btn-sm btn-info" })
                            @if (item.Status == "Initiated")
                            {
                                @Html.ActionLink("Edit", "Edit", new { id = item.RequestId }, new { @class = "btn btn-sm btn-warning" })
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; padding: 20px;">
                        <p>No maintenance requests found.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
